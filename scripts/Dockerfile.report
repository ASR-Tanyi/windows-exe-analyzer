# Host build and runtime both use Ubuntu 24.04 / LLVM 18.
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends libllvm18 \
    && rm -rf /var/lib/apt/lists/*
COPY windows-exe-analyzer /usr/local/bin/windows-exe-analyzer
ENTRYPOINT ["/usr/local/bin/windows-exe-analyzer"]
