# Host build and runtime both use Ubuntu 24.04. The default Capstone decoder is
# linked into the executable; retain LLVM 18 for optional text-backend builds.
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends libllvm18 \
    && rm -rf /var/lib/apt/lists/*
COPY windows-exe-analyzer /usr/local/bin/windows-exe-analyzer
ENTRYPOINT ["/usr/local/bin/windows-exe-analyzer"]
